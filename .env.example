# =============================================================================
# ReviewLoop AI — environment template
# Copy to .env.local and fill in. The app runs with ONLY the Supabase vars set
# and AI_PROVIDER=mock. Everything else is optional and degrades gracefully.
# Run `npm run verify:env` to check your configuration (never prints secrets).
# =============================================================================

# ---- Supabase (REQUIRED for a real backend) ---------------------------------
# Public (safe in the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret — NEVER expose to the client. Needed for the Stripe webhook.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI provider (OPTIONAL — defaults to mock) ------------------------------
# mock = deterministic, no key required (recommended for local + demo).
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Email review requests (OPTIONAL — Resend) ------------------------------
# Without these, email sends are mocked (logged) and requests still record.
RESEND_API_KEY=
FROM_EMAIL=

# ---- SMS review requests (OPTIONAL — Twilio) --------------------------------
# Provide a Messaging Service SID OR a from phone number. Mocked if unset.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# ---- Billing (OPTIONAL — Stripe) --------------------------------------------
# Without STRIPE_SECRET_KEY the billing UI shows "not configured" and is safe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price IDs per plan (public — price IDs are not secrets):
NEXT_PUBLIC_STRIPE_PRICE_STARTER=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS=
NEXT_PUBLIC_STRIPE_PRICE_AGENCY=

# ---- App --------------------------------------------------------------------
# Public base URL of the deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails allowed to view the internal /app/admin debug page.
# If empty, admin access falls back to the organization owner only.
ADMIN_EMAILS=
# Signing key for public one-click email opt-out links (/optout/<token>).
# Optional: if unset, falls back to SUPABASE_SERVICE_ROLE_KEY. The opt-out page
# also needs the service-role key to apply the change without a login.
OPTOUT_SECRET=
